  idPunto: Punto B
  tema: Multiplicacion y division
  descripcion: En este punto se practicaran multiplicaciones y divisiones basicas
  imagen: {fileID: 1006154111, guid: 1b41c30f038973248bd1bfd5a24e4f69, type: 3}
  preguntas:
  - textoTeorico: Multiplicar significa sumar una misma cantidad varias veces.
    enunciadoPregunta: Cuanto es 3 x 2?
    respuesta1: 3
    respuesta2: 5
    respuesta3: 6
    indiceRespuestaCorrecta: 2
  - textoTeorico: Dividir significa repartir una cantidad en partes iguales.
    enunciadoPregunta: "Cuanto es 8  \xF7 2?"
    respuesta1: 3
    respuesta2: 4
    respuesta3: 6
    indiceRespuestaCorrecta: 1
